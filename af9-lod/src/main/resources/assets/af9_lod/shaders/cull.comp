#version 430 core
// One thread per LOD cell: frustum + distance-band culling, writes one DrawArraysIndirectCommand per cell.
layout(local_size_x = 64) in;

struct Cell {
    vec4 minPos;       // xyz = world-space min corner (camera-relative), w = edge length in blocks
    uint firstQuad;    // index of the cell's first quad in the quad buffer
    uint quadCount;
    uint level;
    uint pad;
};
struct DrawCmd { uint count; uint instanceCount; uint first; uint baseInstance; };

layout(std430, binding = 0) readonly buffer Cells { Cell cells[]; };
layout(std430, binding = 1) writeonly buffer Cmds { DrawCmd cmds[]; };

uniform vec4 uPlanes[6];     // frustum planes, camera-relative, normals point inward
uniform uint uCellCount;
uniform float uNearBand;     // cells entirely closer than this are drawn by vanilla/Embeddium instead
uniform float uFarBand;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCellCount) return;
    Cell c = cells[i];
    vec3 lo = c.minPos.xyz, hi = lo + vec3(c.minPos.w);
    bool visible = c.quadCount > 0u;

    for (int p = 0; p < 6 && visible; p++) {
        vec3 n = uPlanes[p].xyz;
        // positive vertex: the corner furthest along the plane normal
        vec3 v = mix(lo, hi, greaterThan(n, vec3(0.0)));
        if (dot(n, v) + uPlanes[p].w < 0.0) visible = false;
    }
    if (visible) {
        vec3 nearest = clamp(vec3(0.0), lo, hi);
        float d = length(nearest);
        float farthest = length(max(abs(lo), abs(hi)));
        if (farthest < uNearBand || d > uFarBand) visible = false;
    }
    cmds[i] = DrawCmd(6u, visible ? c.quadCount : 0u, 0u, c.firstQuad);
}
