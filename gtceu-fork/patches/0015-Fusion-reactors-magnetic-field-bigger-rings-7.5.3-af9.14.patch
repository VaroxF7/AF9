+package com.gregtechceu.gtceu.common.machine.multiblock.electric;
+
+import com.gregtechceu.gtceu.api.GTValues;
+
+/**
+ * AF9: the size of the fusion reactors' ring. GT's ring is 15 x 15 blocks; the Mk1 to Mk3 get more of the same ring by
+ * lengthening its straight sides: the centre column and the centre row of the pattern are repeated, so the ring keeps its
+ * shape, its four coil blocks and its hatch positions. Mk1 is 19 x 19, Mk2 23 x 23, Mk3 27 x 27.
+ */
+public final class FusionStructure {
+
+    /** The column / row of GT's 15 x 15 pattern that is repeated: its centre. */
+    private static final int CENTER = 7;
+
+    private FusionStructure() {}
+
+    /** How many columns and rows are added to GT's 15 x 15 ring (even, so the controller stays in the middle). */
+    public static int extra(int tier) {
+        return switch (tier) {
+            case GTValues.LuV -> 4;
+            case GTValues.ZPM -> 8;
+            case GTValues.UV -> 12;
+            default -> 0;
+        };
+    }
+
+    /** Half the width of the ring, in blocks: 7 for GT's ring. The ring's centre is this far behind the controller. */
+    public static int halfSize(int tier) {
+        return CENTER + extra(tier) / 2;
+    }
+
+    /**
+     * GT's aisles (15 aisles of 3 strings of 15 characters) with the centre aisle and the centre column repeated {@code extra}
+     * times in all. {@code controller} (the controller character) is repeated as {@code fill} so there is only one controller.
+     */
+    public static String[][] expand(String[][] base, int extra, char controller, char fill) {
+        int half = extra / 2;
+        String[][] widened = new String[base.length][];
+        for (int a = 0; a < base.length; a++) {
+            widened[a] = new String[base[a].length];
+            for (int s = 0; s < base[a].length; s++) {
+                String row = base[a][s];
+                char mid = row.charAt(CENTER);
+                char dup = mid == controller ? fill : mid;
+                widened[a][s] = row.substring(0, CENTER) + String.valueOf(dup).repeat(half) + mid +
+                        String.valueOf(dup).repeat(half) + row.substring(CENTER + 1);
+            }
+        }
+        String[][] result = new String[base.length + extra][];
+        int out = 0;
+        for (int a = 0; a < widened.length; a++) {
+            result[out++] = widened[a];
+            if (a == CENTER) {
+                for (int i = 0; i < extra; i++) result[out++] = widened[a].clone();
+            }
+        }
+        return result;
+    }
+}
