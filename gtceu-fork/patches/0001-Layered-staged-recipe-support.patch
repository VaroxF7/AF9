+            return input(ItemRecipeCapability.CAP,
+                    Arrays.stream(inputs)
+                            .map(stack -> InputItem.of(
+                                    stack.hasTag() ? StrictNBTIngredient.of(stack) : Ingredient.of(stack),
+                                    stack.getCount()))
+                            .toArray());
+        }
