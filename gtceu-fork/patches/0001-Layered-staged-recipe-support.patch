diff --git a/src/main/java/com/gregtechceu/gtceu/api/machine/multiblock/LayeredWorkableElectricMultiblockMachine.java b/src/main/java/com/gregtechceu/gtceu/api/machine/multiblock/LayeredWorkableElectricMultiblockMachine.java
