From 0f7e0efcc3192b7d30ae8c2bcf294b8a1b9f8018 Mon Sep 17 00:00:00 2001
From: AF9 <af9@localhost>
Date: Sat, 17 Oct 2026 10:18:25 +0000
Subject: [PATCH] Multiblock preview zooms out to fit a big structure
 (7.5.3-af9.10)

The preview scene's camera distance grows with the square root of the structure's largest side, which clips
anything tall: a 130 block tower shows about a third of itself and the wheel moves half a block a notch.
Structures over 40 blocks are zoomed out until they fit.
---
 .../api/gui/widget/PatternPreviewWidget.java  | 31 ++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/main/java/com/gregtechceu/gtceu/api/gui/widget/PatternPreviewWidget.java b/src/main/java/com/gregtechceu/gtceu/api/gui/widget/PatternPreviewWidget.java
index 3855367..1b13418 100644
--- a/src/main/java/com/gregtechceu/gtceu/api/gui/widget/PatternPreviewWidget.java
+++ b/src/main/java/com/gregtechceu/gtceu/api/gui/widget/PatternPreviewWidget.java
@@ -220,7 +220,34 @@ public class PatternPreviewWidget extends WidgetGroup {
                 stream = stream.filter(pos -> !modelDisabled.contains(pos.asLong()));
             }
         }
-        sceneWidget.setRenderedCore(stream.toList(), null);
+        List<BlockPos> shown = stream.toList();
+        sceneWidget.setRenderedCore(shown, null);
+        fitZoom(shown);
+    }
+
+    /**
+     * AF9: the scene's own zoom grows with the square root of the structure's size, which clips anything tall (a 130 block
+     * tower shows about a third of itself). Structures over 40 blocks in one direction are zoomed out until the whole of them
+     * fits the view.
+     */
+    private void fitZoom(Collection<BlockPos> blocks) {
+        if (blocks.isEmpty()) return;
+        int minX = Integer.MAX_VALUE, minY = Integer.MAX_VALUE, minZ = Integer.MAX_VALUE;
+        int maxX = Integer.MIN_VALUE, maxY = Integer.MIN_VALUE, maxZ = Integer.MIN_VALUE;
+        for (BlockPos pos : blocks) {
+            minX = Math.min(minX, pos.getX());
+            minY = Math.min(minY, pos.getY());
+            minZ = Math.min(minZ, pos.getZ());
+            maxX = Math.max(maxX, pos.getX());
+            maxY = Math.max(maxY, pos.getY());
+            maxZ = Math.max(maxZ, pos.getZ());
+        }
+        float height = maxY - minY + 1, width = Math.max(maxX - minX + 1, maxZ - minZ + 1);
+        if (Math.max(height, width) < 40) return;
+        // what the tilted view of the box needs, and the camera distance that shows that much
+        float needed = Math.max(width * 1.4f, height * 0.87f + width * 0.5f);
+        float fit = needed * 0.95f;
+        if (fit > sceneWidget.getZoom()) sceneWidget.setZoom(fit);
     }
 
     public static PatternPreviewWidget getPatternWidget(MultiblockMachineDefinition controllerDefinition) {
@@ -274,6 +301,7 @@ public class PatternPreviewWidget extends WidgetGroup {
             loadControllerFormed(pattern.blockMap.keySet(), controllerBase);
         } else {
             sceneWidget.setRenderedCore(pattern.blockMap.keySet(), null);
+            fitZoom(pattern.blockMap.keySet());
             controllerBase.onStructureInvalid();
         }
     }
@@ -434,6 +462,7 @@ public class PatternPreviewWidget extends WidgetGroup {
                 positions.removeIf(pos -> modelDisabled.contains(pos.asLong()));
             }
             sceneWidget.setRenderedCore(positions, null);
+            fitZoom(positions);
         } else {
             GTCEu.LOGGER.warn("Pattern formed checking failed: {}", controllerBase.self().getDefinition());
         }
