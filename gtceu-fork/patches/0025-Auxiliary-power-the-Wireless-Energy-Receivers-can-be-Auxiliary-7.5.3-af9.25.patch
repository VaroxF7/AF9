 @ParametersAreNonnullByDefault
 @MethodsReturnNonnullByDefault
-public class EnergyHatchPartMachine extends TieredIOPartMachine implements IExplosionMachine {
+public class EnergyHatchPartMachine extends TieredIOPartMachine implements IExplosionMachine, com.gregtechceu.gtceu.api.machine.feature.IAuxiliaryPowerPart {
 
     protected static final ManagedFieldHolder MANAGED_FIELD_HOLDER = new ManagedFieldHolder(
             EnergyHatchPartMachine.class, TieredIOPartMachine.MANAGED_FIELD_HOLDER);
@@ -94,10 +94,16 @@ public class EnergyHatchPartMachine extends TieredIOPartMachine implements IExpl
     }
 
     /** Whether this is an input hatch set to Auxiliary. */
+    @Override
     public boolean isAuxiliaryInput() {
         return auxiliary && io == IO.IN;
     }
 
+    @Override
+    public NotifiableEnergyContainer getAuxiliaryContainer() {
+        return energyContainer;
+    }
+
     /** An auxiliary hatch is no part of the primary power: the recipes do not see it. */
     @Override
     public java.util.List<RecipeHandlerList> getRecipeHandlers() {
