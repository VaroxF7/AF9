diff --git a/src/main/java/com/gregtechceu/gtceu/api/machine/feature/IAuxiliaryPowerPart.java b/src/main/java/com/gregtechceu/gtceu/api/machine/feature/IAuxiliaryPowerPart.java
new file mode 100644
index 0000000..87bb84f
--- /dev/null
+++ b/src/main/java/com/gregtechceu/gtceu/api/machine/feature/IAuxiliaryPowerPart.java
@@ -0,0 +1,16 @@
+package com.gregtechceu.gtceu.api.machine.feature;
+
+import com.gregtechceu.gtceu.api.machine.trait.NotifiableEnergyContainer;
+
+/**
+ * AF9: an energy input part that can be switched to Auxiliary power (the energy hatches, the Wireless Energy Receivers). A
+ * multiblock draws its auxiliary demand from every such part that is in Auxiliary mode.
+ */
+public interface IAuxiliaryPowerPart {
+
+    /** Whether the part is an input set to Auxiliary. */
+    boolean isAuxiliaryInput();
+
+    /** The buffer the auxiliary power is drawn from. */
+    NotifiableEnergyContainer getAuxiliaryContainer();
+}
diff --git a/src/main/java/com/gregtechceu/gtceu/api/machine/multiblock/WorkableMultiblockMachine.java b/src/main/java/com/gregtechceu/gtceu/api/machine/multiblock/WorkableMultiblockMachine.java
index 744ccb3..b0fffd9 100644
--- a/src/main/java/com/gregtechceu/gtceu/api/machine/multiblock/WorkableMultiblockMachine.java
+++ b/src/main/java/com/gregtechceu/gtceu/api/machine/multiblock/WorkableMultiblockMachine.java
@@ -302,21 +302,38 @@ public abstract class WorkableMultiblockMachine extends MultiblockControllerMach
         return hatches;
     }
 
+    /** Every part in Auxiliary mode: GT's energy hatches and the Wireless Energy Receivers. */
+    public List<com.gregtechceu.gtceu.api.machine.feature.IAuxiliaryPowerPart> getAuxiliaryParts() {
+        List<com.gregtechceu.gtceu.api.machine.feature.IAuxiliaryPowerPart> parts = new ArrayList<>();
+        for (IMultiPart part : getParts()) {
+            if (part instanceof com.gregtechceu.gtceu.api.machine.feature.IAuxiliaryPowerPart aux &&
+                    aux.isAuxiliaryInput()) {
+                parts.add(aux);
+            }
+        }
+        return parts;
+    }
+
+    public boolean hasAuxiliary() {
+        return !getAuxiliaryParts().isEmpty();
+    }
+
     public long getAuxiliaryStored() {
         long stored = 0;
-        for (var hatch : getAuxiliaryHatches()) stored += hatch.energyContainer.getEnergyStored();
+        for (var part : getAuxiliaryParts()) stored += part.getAuxiliaryContainer().getEnergyStored();
         return stored;
     }
 
-    /** Takes EU from the auxiliary hatches; false (and nothing taken) when they hold less. */
+    /** Takes EU from the auxiliary parts; false (and nothing taken) when they hold less. */
     public boolean drawAuxiliary(long eut) {
         if (eut <= 0) return true;
         if (getAuxiliaryStored() < eut) return false;
         long left = eut;
-        for (var hatch : getAuxiliaryHatches()) {
-            long take = Math.min(left, hatch.energyContainer.getEnergyStored());
+        for (var part : getAuxiliaryParts()) {
+            var container = part.getAuxiliaryContainer();
+            long take = Math.min(left, container.getEnergyStored());
             if (take > 0) {
-                hatch.energyContainer.changeEnergy(-take);
+                container.changeEnergy(-take);
                 left -= take;
             }
             if (left <= 0) break;
diff --git a/src/main/java/com/gregtechceu/gtceu/common/machine/multiblock/electric/FusionReactorMachine.java b/src/main/java/com/gregtechceu/gtceu/common/machine/multiblock/electric/FusionReactorMachine.java
index c81d008..24a6eaa 100644
--- a/src/main/java/com/gregtechceu/gtceu/common/machine/multiblock/electric/FusionReactorMachine.java
+++ b/src/main/java/com/gregtechceu/gtceu/common/machine/multiblock/electric/FusionReactorMachine.java
@@ -151,7 +151,7 @@ public class FusionReactorMachine extends WorkableElectricMultiblockMachine impl
 
     /** AF9: the auxiliary hatches pay the field when there are any, else the primary hatches do. */
     private boolean drawField(long eut) {
-        if (!getAuxiliaryHatches().isEmpty()) return drawAuxiliary(eut);
+        if (hasAuxiliary()) return drawAuxiliary(eut);
         return getEnergyContainer() != null && getEnergyContainer().getEnergyStored() >= eut &&
                 getEnergyContainer().removeEnergy(eut) > 0;
     }
diff --git a/src/main/java/com/gregtechceu/gtceu/common/machine/multiblock/part/EnergyHatchPartMachine.java b/src/main/java/com/gregtechceu/gtceu/common/machine/multiblock/part/EnergyHatchPartMachine.java
