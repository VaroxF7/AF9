@@ -149,6 +149,34 @@ public class FusionReactorMachine extends WorkableElectricMultiblockMachine impl
         }
     }
 
+    /** AF9: most primary energy hatches (not in Auxiliary mode) and laser hatches the power may come from. */
+    public static final int MAX_PRIMARY_ENERGY_HATCHES = 2;
+    public static final int MAX_LASER_HATCHES = 1;
+
+    /** AF9: energy hatches in primary mode (the wireless receivers too); Auxiliary ones do not count. */
+    public int countPrimaryEnergyHatches() {
+        int n = 0;
+        for (var part : getParts()) {
+            if (part instanceof com.gregtechceu.gtceu.api.machine.feature.IAuxiliaryPowerPart aux) {
+                if (!aux.isAuxiliaryInput()) n++;
+            }
+        }
+        return n;
+    }
+
+    public int countLaserHatches() {
+        int n = 0;
+        for (var part : getParts()) {
+            if (part instanceof com.gregtechceu.gtceu.common.machine.multiblock.part.LaserHatchPartMachine) n++;
+        }
+        return n;
+    }
+
+    /** AF9: the structure takes any number of energy hatches; only two may be primary, the rest must be Auxiliary. */
+    public boolean isPowerLayoutValid() {
+        return countPrimaryEnergyHatches() <= MAX_PRIMARY_ENERGY_HATCHES && countLaserHatches() <= MAX_LASER_HATCHES;
+    }
+
     /** AF9: the auxiliary hatches pay the field when there are any, else the primary hatches do. */
     private boolean drawField(long eut) {
         if (hasAuxiliary()) return drawAuxiliary(eut);
@@ -189,7 +217,7 @@ public class FusionReactorMachine extends WorkableElectricMultiblockMachine impl
 
     /** AF9: builds the field, also while a reaction runs; a full field draws nothing. */
     protected void fieldTick() {
-        if (!isFormed() || !isWorkingEnabled()) return;
+        if (!isFormed() || !isWorkingEnabled() || !isPowerLayoutValid()) return;
         if (fieldStrength >= getFieldCapacity()) return;
         if (drawField(fieldChargeEUt(tier))) {
             setFieldStrength(fieldStrength + fieldRegen(tier));
@@ -231,6 +259,9 @@ public class FusionReactorMachine extends WorkableElectricMultiblockMachine impl
             return ModifierFunction
                     .cancel(Component.translatable("gtceu.recipe_modifier.insufficient_eu_to_start_fusion"));
