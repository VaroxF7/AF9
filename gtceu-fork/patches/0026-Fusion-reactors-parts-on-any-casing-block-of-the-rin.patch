+        }
         if (fusionReactorMachine.fieldStrength < minField(recipe)) {
             return ModifierFunction.cancel(Component.translatable("af9.fusion.field_low", minField(recipe)));
         }
@@ -278,6 +309,9 @@ public class FusionReactorMachine extends WorkableElectricMultiblockMachine impl
