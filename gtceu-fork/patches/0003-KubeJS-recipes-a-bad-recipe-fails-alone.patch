--- /dev/null
+++ b/src/main/java/com/gregtechceu/gtceu/core/mixins/kubejs/RecipesEventJSMixin.java
@@ -0,0 +1,31 @@
+package com.gregtechceu.gtceu.core.mixins.kubejs;
+
+import dev.latvian.mods.kubejs.event.EventHandler;
+import dev.latvian.mods.kubejs.event.EventJS;
+import dev.latvian.mods.kubejs.event.EventResult;
+import dev.latvian.mods.kubejs.recipe.RecipesEventJS;
+import dev.latvian.mods.kubejs.script.ScriptTypeHolder;
+import dev.latvian.mods.kubejs.util.ConsoleJS;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Redirect;
+
+/**
+ * AF9: KubeJS posts its recipe event without an exception handler, so the first recipe script that throws (GT's
+ * builders throw on a bad value) ends the event for every script after it: their recipes are simply not there. With a
+ * handler, the script that threw ends where it threw, the error names it, and the next script runs.
+ */
+@Mixin(value = RecipesEventJS.class, remap = false)
+public class RecipesEventJSMixin {
+
+    @Redirect(method = "post",
+              at = @At(value = "INVOKE",
+                       target = "Ldev/latvian/mods/kubejs/event/EventHandler;post(Ldev/latvian/mods/kubejs/script/ScriptTypeHolder;Ldev/latvian/mods/kubejs/event/EventJS;)Ldev/latvian/mods/kubejs/event/EventResult;"))
+    private EventResult gtceu$postRecipeEvent(EventHandler handler, ScriptTypeHolder type, EventJS event) {
+        return handler.post(type, event, (posted, container, error) -> {
+            ConsoleJS.SERVER.error("Error in recipe script " + container + ": its recipes after this are missing",
+                    error);
+            return null;
+        });
+    }
+}
