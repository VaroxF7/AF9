From e9f8227d4d37bd83e89c6df7862dc406884c2173 Mon Sep 17 00:00:00 2001
From: AF9 <af9@localhost>
Date: Thu, 29 Oct 2026 19:34:19 +0000
Subject: [PATCH] The Universal Cell holds any fluid: any temperature, gas,
 acid, cryogenic and plasma proof, so the Canner fills it with molten metals
 and plasmas (7.5.3-af9.30)

AF9: the Particle Accelerator's cells (molten tungsten, molten rhenium-127, osmium plasma) are Universal Cells filled in the Canner.
---
 gradle.properties                                            | 2 +-
 src/main/java/com/gregtechceu/gtceu/common/data/GTItems.java | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/gradle.properties b/gradle.properties
index 3ab3f13..6fc7f43 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -6,7 +6,7 @@ org.gradle.caching = true
 # Mod Info
 mod_id = gtceu
 mod_name = GregTech
-mod_version = 7.5.3-af9.29
+mod_version = 7.5.3-af9.30
 mod_description = GregTech CE Unofficial, ported from 1.12.2
 mod_license = LGPL-3.0 license
 mod_url = https://github.com/GregTechCEu/GregTech-Modern/
diff --git a/src/main/java/com/gregtechceu/gtceu/common/data/GTItems.java b/src/main/java/com/gregtechceu/gtceu/common/data/GTItems.java
index a97e448..3a4f829 100644
--- a/src/main/java/com/gregtechceu/gtceu/common/data/GTItems.java
+++ b/src/main/java/com/gregtechceu/gtceu/common/data/GTItems.java
@@ -371,7 +371,8 @@ public class GTItems {
             .color(() -> GTItems::cellColor)
             .setData(ProviderType.ITEM_MODEL, NonNullBiConsumer.noop())
             .onRegister(attach(cellName(),
-                    ThermalFluidStats.create(FluidType.BUCKET_VOLUME, 1800, true, false, false, false, true),
+                    // AF9: the Universal Cell holds any fluid at any temperature (molten metals, plasmas, acids, cryogens)
+                    ThermalFluidStats.create(FluidType.BUCKET_VOLUME, Integer.MAX_VALUE, true, true, true, true, true),
                     new ItemFluidContainer()))
             .register();
     public static ItemEntry<ComponentItem> FLUID_CELL_LARGE_STEEL = createFluidCell(GTMaterials.Steel, 8, 4, 64);
