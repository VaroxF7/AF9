+
+    /**
+     * What an Active Cooler makes of a coolant at its full rate (8 mB/t): its cooling per tick. A fluid of the
+     * coolants tag that is not listed counts {@link #BASE_COOLANT_STRENGTH}, like the PCB Coolant.
+     */
+    public static final int BASE_COOLANT_STRENGTH = 2;
+    private static final Object2IntMap<ResourceLocation> COOLANT_STRENGTH = new Object2IntOpenHashMap<>();
+
+    static {
+        registerCoolant(new ResourceLocation("gtceu", "supercooled_hydrogen"), 8);
+        registerCoolant(new ResourceLocation("gtceu", "supercooled_argon"), 12);
+        registerCoolant(new ResourceLocation("gtceu", "supercooled_xenon"), 16);
+        registerCoolant(new ResourceLocation("gtceu", "supercooled_endion"), 20);
+    }
+
+    /** Sets the cooling an Active Cooler gets out of a fluid at its full rate (the PCB Coolant gives 2). */
+    public static void registerCoolant(ResourceLocation fluid, int strength) {
+        COOLANT_STRENGTH.put(fluid, strength);
+    }
+
+    public static int coolantStrength(Fluid fluid) {
+        return COOLANT_STRENGTH.getOrDefault(BuiltInRegistries.FLUID.getKey(fluid), BASE_COOLANT_STRENGTH);
+    }
