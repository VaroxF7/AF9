+            double wanted = forceCoolWithActive ? Double.MAX_VALUE : Math.max(0, temperatureChange);
+            if (wanted <= 0 || maxCoolantDrain <= 0) {
+                return temperatureChange;
+            }
+
+            // the strongest coolant first; the active coolers' rate (maxCoolantDrain mB/t) is shared among them
+            List<Fluid> coolants = new ArrayList<>();
+            for (var fluid : BuiltInRegistries.FLUID.getTagOrEmpty(HPCA_COOLANTS)) {
