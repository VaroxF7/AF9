 .../gtceu/blockstates/large_wiremill.json     | 114 ------------------
 .../models/block/machine/large_wiremill.json  |  90 --------------
 .../gtceu/models/item/large_wiremill.json     |   3 -
 3 files changed, 207 deletions(-)
 delete mode 100644 src/generated/resources/assets/gtceu/blockstates/large_wiremill.json
 delete mode 100644 src/generated/resources/assets/gtceu/models/block/machine/large_wiremill.json
 delete mode 100644 src/generated/resources/assets/gtceu/models/item/large_wiremill.json

