+/**
+ * AF9: the "Power Management" tab of every multiblock's screen: the primary power (the energy hatches that run the recipes)
+ * and the auxiliary power (the energy hatches switched to Auxiliary, which keep the machine at its working temperature).
+ */
+public class PowerManagementFancyTab implements IFancyUIProvider {
+
+    private final WorkableMultiblockMachine machine;
+
+    public PowerManagementFancyTab(WorkableMultiblockMachine machine) {
+        this.machine = machine;
+    }
+
+    @Override
+    public Component getTitle() {
+        return Component.translatable("af9.power.title");
+    }
+
+    @Override
+    public IGuiTexture getTabIcon() {
+        return GuiTextures.BUTTON_POWER.getSubTexture(0, 0, 1, 0.5);
+    }
+
+    @Override
+    public List<Component> getTabTooltips() {
+        return List.of(Component.translatable("af9.power.title"));
+    }
+
+    @Override
+    public Widget createMainPage(FancyMachineUIWidget widget) {
+        var group = new WidgetGroup(0, 0, 150, 130);
+        group.setBackground(GuiTextures.BACKGROUND_INVERSE);
+        group.addWidget(new ComponentPanelWidget(6, 6, this::lines)
+                .textSupplier(machine.isRemote() ? null : this::lines).setMaxWidthLimit(138));
+        return group;
+    }
+
+    private void lines(List<Component> out) {
+        out.add(Component.translatable("af9.power.title").withStyle(ChatFormatting.WHITE, ChatFormatting.UNDERLINE));
+        out.add(Component.empty());
+        out.add(Component.translatable("af9.power.primary").withStyle(ChatFormatting.AQUA));
+        if (machine instanceof WorkableElectricMultiblockMachine electric && electric.isFormed() &&
+                electric.getEnergyContainer() != null && electric.getEnergyContainer().getInputVoltage() > 0) {
+            var container = electric.getEnergyContainer();
+            int tier = Math.max(0, Math.min(GTValues.MAX, GTUtil.getFloorTierByVoltage(container.getInputVoltage())));
+            out.add(Component.translatable("af9.power.supply", GTValues.VNF[tier],
+                    FormattingUtil.formatNumbers(container.getInputAmperage())));
+            var recipe = electric.getRecipeLogic().isWorking() ? electric.getRecipeLogic().getLastRecipe() : null;
+            long eut = recipe == null ? 0 : RecipeHelper.getRealEUt(recipe).getTotalEU();
+            out.add(Component.translatable("af9.power.draw", FormattingUtil.formatNumbers(eut)));
+        } else {
+            out.add(Component.translatable("af9.power.none").withStyle(ChatFormatting.GRAY));
+        }
+        out.add(Component.empty());
+        out.add(Component.translatable("af9.power.auxiliary").withStyle(ChatFormatting.GOLD));
+        int hatches = machine.getAuxiliaryHatches().size();
+        long need = machine.getAuxiliaryEUt();
+        long stored = machine.getAuxiliaryStored();
+        if (hatches == 0) {
+            out.add(Component.translatable("af9.power.aux_none").withStyle(ChatFormatting.GRAY));
+        } else {
+            out.add(Component.translatable("af9.power.aux_hatches", hatches));
+            out.add(Component.translatable("af9.power.aux_stored", FormattingUtil.formatNumbers(stored)));
+        }
+        if (need > 0) {
+            out.add(Component.translatable("af9.power.aux_need", FormattingUtil.formatNumbers(need))
+                    .withStyle(stored >= need ? ChatFormatting.GREEN : ChatFormatting.RED));
+        } else {
+            out.add(Component.translatable("af9.power.aux_idle").withStyle(ChatFormatting.GRAY));
+        }
+        out.add(Component.empty());
+        out.add(Component.translatable("af9.power.hint").withStyle(ChatFormatting.DARK_GRAY));
+    }
+}
