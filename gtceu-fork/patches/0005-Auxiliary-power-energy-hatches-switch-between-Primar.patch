+    // ---- AF9: auxiliary power ----
+
+    /** The recipe data key of the auxiliary power (EU/t) a recipe asks for while it runs. */
+    public static final String AUXILIARY_EUT = "af9_aux_eut";
+
+    public static long auxiliaryEUtOf(@Nullable GTRecipe recipe) {
+        return recipe == null ? 0 : recipe.data.getLong(AUXILIARY_EUT);
+    }
+
+    /** What a machine keeps drawing from its auxiliary hatches whatever it runs (a heat mass, a vacuum): 0 by default. */
+    protected long getBaseAuxiliaryEUt() {
+        return 0;
+    }
+
+    /** The auxiliary EU/t the machine needs now: its base and the running recipe's, the higher. */
+    public long getAuxiliaryEUt() {
+        GTRecipe running = recipeLogic.isWorking() ? recipeLogic.getLastRecipe() : null;
+        return Math.max(getBaseAuxiliaryEUt(), auxiliaryEUtOf(running));
+    }
+
+    public List<com.gregtechceu.gtceu.common.machine.multiblock.part.EnergyHatchPartMachine> getAuxiliaryHatches() {
+        List<com.gregtechceu.gtceu.common.machine.multiblock.part.EnergyHatchPartMachine> hatches = new ArrayList<>();
+        for (IMultiPart part : getParts()) {
+            if (part instanceof com.gregtechceu.gtceu.common.machine.multiblock.part.EnergyHatchPartMachine hatch &&
+                    hatch.isAuxiliaryInput()) {
+                hatches.add(hatch);
+            }
+        }
+        return hatches;
+    }
+
+    public long getAuxiliaryStored() {
+        long stored = 0;
+        for (var hatch : getAuxiliaryHatches()) stored += hatch.energyContainer.getEnergyStored();
+        return stored;
+    }
+
+    /** Takes EU from the auxiliary hatches; false (and nothing taken) when they hold less. */
+    public boolean drawAuxiliary(long eut) {
+        if (eut <= 0) return true;
+        if (getAuxiliaryStored() < eut) return false;
+        long left = eut;
+        for (var hatch : getAuxiliaryHatches()) {
+            long take = Math.min(left, hatch.energyContainer.getEnergyStored());
+            if (take > 0) {
+                hatch.energyContainer.changeEnergy(-take);
+                left -= take;
+            }
+            if (left <= 0) break;
+        }
+        return true;
+    }
+
     @Override
     public boolean beforeWorking(@Nullable GTRecipe recipe) {
+        long auxiliary = Math.max(getBaseAuxiliaryEUt(), auxiliaryEUtOf(recipe));
+        if (auxiliary > 0 && getAuxiliaryStored() < auxiliary) return false;
         for (IMultiPart part : getParts()) {
             if (!part.beforeWorking(this)) {
                 return false;
